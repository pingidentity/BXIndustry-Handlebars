<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link id="favicon" rel="icon" href="/public/generic/favicon.ico" />
  <link id="apple-touch-icon" rel="apple-touch-icon" href="/public/generic/apple-touch-icon.png" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Admin: edit .env values" />

  {{! Import bootstrap - bundle build (includes Popper) is required for tooltips to work }}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

  <link href="/styles.css" rel="stylesheet" />

  <style>
    .admin-field-group {
      max-width: 720px;
    }

    .admin-env-tooltip {
      display: inline-block;
      margin-left: 4px;
    }

    .admin-env-tooltip svg {
      width: 14px;
      height: 14px;
      margin-top: -4px;
    }

    :root {
      /* Used for tooltip icon color */
      --bxi-primary-color: var(--bs-blue); 
    }
  </style>
</head>
<body class="bxi">
  <nav class="navbar navbar-expand bg-body-tertiary border-bottom shadow-sm mb-4">
    <div class="container-fluid">
      <button class="btn btn-link ps-0" id="back-button" onclick="history.back()">&laquo; Go Back</button>
      {{!-- <span class="navbar-text fw-bold mx-auto">Admin</span> --}}
      <div class="ms-auto d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary" href="/shortcuts">Shortcuts</a>
      </div>
    </div>
  </nav>

  <div class="container py-4 admin-field-group">
    <form id="admin-env-form">
      <fieldset class="mb-4">
        <legend class="h4">User environment variables</legend>
        {{#each shared}}
          {{> adminEnvField this}}
        {{/each}}
      </fieldset>

      <hr />

      <fieldset class="mb-4" id="widget-group" {{#if useRedirect}}hidden{{/if}}>
        <legend class="h4">DaVinci Widget environment variables</legend>
        {{#each widget}}
          {{> adminEnvField this}}
        {{/each}}
      </fieldset>

      <fieldset class="mb-4" id="oidc-group" {{#unless useRedirect}}hidden{{/unless}}>
        <legend class="h4">OIDC Redirect environment variables</legend>
        {{#each oidc}}
          {{> adminEnvField this}}
        {{/each}}
      </fieldset>

      <div id="save-status" class="alert alert-success d-none" role="alert">
        Changes successfully saved!
      </div>

      <button type="submit" style="color: white;" class="btn btn-primary" id="save-button" disabled>Save All</button>
    </form>

  </div>

  <script type="module" src="/js/admin-env.js"></script>
</body>
</html>
